{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IPTV Publish Manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit_sha": {
      "$ref": "#/$defs/commitSha"
    },
    "candidate_commit_sha": {
      "anyOf": [
        {
          "$ref": "#/$defs/commitSha"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "object",
      "properties": {
        "iptv.m3u": {
          "allOf": [
            {
              "$ref": "#/$defs/fileRecord"
            },
            {
              "properties": {
                "path": {
                  "const": "output/iptv.m3u"
                }
              }
            }
          ]
        },
        "iptv.txt": {
          "allOf": [
            {
              "$ref": "#/$defs/fileRecord"
            },
            {
              "properties": {
                "path": {
                  "const": "output/iptv.txt"
                }
              }
            }
          ]
        },
        "subscription_info.json": {
          "allOf": [
            {
              "$ref": "#/$defs/fileRecord"
            },
            {
              "properties": {
                "path": {
                  "const": "output/subscription_info.json"
                }
              }
            }
          ]
        }
      },
      "required": [
        "iptv.m3u",
        "iptv.txt",
        "subscription_info.json"
      ],
      "additionalProperties": false
    },
    "channel_count": {
      "type": "integer",
      "minimum": 0
    },
    "line_count": {
      "type": "integer",
      "minimum": 0
    },
    "previous_channel_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "previous_line_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "last_successful_daily_update_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_successful_daily_target_slot": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "publish_blocked": {
      "type": "boolean"
    },
    "publish_block_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "layer1_status": {
      "$ref": "#/$defs/status"
    },
    "layer2_status": {
      "$ref": "#/$defs/status"
    },
    "layer3_status": {
      "$ref": "#/$defs/status"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "source_commit_sha",
    "candidate_commit_sha",
    "files",
    "channel_count",
    "line_count",
    "previous_channel_count",
    "previous_line_count",
    "last_successful_daily_update_at",
    "last_successful_daily_target_slot",
    "publish_blocked",
    "publish_block_reason",
    "layer1_status",
    "layer2_status",
    "layer3_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "previous_channel_count": {
              "type": "null"
            },
            "previous_line_count": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "previous_channel_count": {
              "type": "integer",
              "minimum": 0
            },
            "previous_line_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "commitSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "unverified"]
    },
    "fileRecord": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": ["path", "size_bytes", "sha256"],
      "additionalProperties": false
    }
  }
}
