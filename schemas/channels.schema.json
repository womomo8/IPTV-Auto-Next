
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IPTV Channel Dictionary",
  "type": "object",
  "properties": {
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tvg_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "tvg_id",
          "canonical_name",
          "aliases"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["channels"],
  "additionalProperties": false
}
